<?xml version="1.0"?>
<psalm errorLevel="1" resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config" xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd" findUnusedBaselineEntry="true" findUnusedCode="true" phpVersion="8.1">
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </UnusedClass>
        <UnusedClosureParam>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </UnusedClosureParam>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <!--
            Container.get() and tryGet() now return mixed (PSR-11 compliance +
            scalar-by-name support). Tests that assert on returned values
            against mixed/dynamic-property objects need these suppressed.
        -->
        <MixedAssignment>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </MixedAssignment>
        <MixedPropertyFetch>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </MixedPropertyFetch>
        <MixedReturnStatement>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </MixedReturnStatement>
        <!--
            A class marked @internal is internal to the package, not to its own test suite —
            psalm scopes @internal by namespace, and the tests live under Tests\.
        -->
        <InternalClass>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </InternalMethod>
    </issueHandlers>
</psalm>
